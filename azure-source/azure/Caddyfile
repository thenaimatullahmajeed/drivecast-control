{$DRIVECAST_HOST} {
    encode zstd gzip
    request_body {
        max_size 48MB
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }
    reverse_proxy web:8080 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
    }
}
