# Copy to .env on the VM only, chmod 600. Never commit the real file.
DRIVECAST_HOST=your-label.eastus.cloudapp.azure.com
DRIVECAST_ORIGIN=https://your-label.eastus.cloudapp.azure.com
DRIVECAST_OAUTH_REDIRECT=https://your-label.eastus.cloudapp.azure.com/oauth/callback
DRIVECAST_DATA_DIR=/data
DRIVECAST_HOSTED=1
DRIVECAST_LIVE_UPLOADS=0
DRIVECAST_WORKERS=2
DRIVECAST_PROJECT_DAILY_LIMIT=90
DRIVECAST_MAX_VIDEO_MB=250
DRIVECAST_MONTHLY_TRANSFER_GB=100
DRIVECAST_TRIAL_END=2026-11-20
DRIVECAST_BACKUP_KEY=REPLACE_WITH_RANDOM_32_BYTE_BASE64_KEY
DRIVECAST_BACKUP_STORAGE=
DRIVECAST_BACKUP_CONTAINER=drivecast-backups
DRIVECAST_BACKUP_INTERVAL_SECONDS=3600
# Optional email reset (use an app password/provider relay, never your mailbox password):
# DRIVECAST_SMTP_HOST=
# DRIVECAST_SMTP_PORT=587
# DRIVECAST_SMTP_FROM=
# DRIVECAST_SMTP_USER=
# DRIVECAST_SMTP_PASSWORD=
